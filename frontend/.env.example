# ==============================================================
# AI Factory Operating System — Frontend Environment Variables
# Copy this file to .env:  cp .env.example .env
# ==============================================================

# Backend API base URL (leave empty or use relative path for local Vite proxy)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket stream URL (e.g., ws://localhost:8000/ws/live)
VITE_WS_URL=ws://localhost:8000/ws/live

# Demo Mode toggle: when true, UI falls back to typed mock data if backend sleeps
VITE_DEMO_MODE=true
