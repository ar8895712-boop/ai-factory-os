# ==============================================================
# AI Factory Operating System — Root .gitattributes
# Ensures cross-platform line ending consistency and diff behavior
# ==============================================================

# Set default behavior to normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure Windows scripts use CRLF if executed on Windows hosts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must always use LF for Linux / Docker environments
*.sh text eol=lf

# Mark media and binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary

