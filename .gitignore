# ==============================================================
# AI Factory Operating System — Root .gitignore
# Production-grade gitignore covering Python, Node, ML, DB, OS
# ==============================================================

# --------------------------------------------------------------
# 1. Environment & Secrets (NEVER COMMIT)
# --------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa
secrets.yaml
credentials.json

# --------------------------------------------------------------
# 2. Configuration with Sensitive / Local Assumptions
# --------------------------------------------------------------
config.yaml
!config.example.yaml

# --------------------------------------------------------------
# 3. Python & Virtual Environments
# --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --------------------------------------------------------------
# 4. Testing & Linters
# --------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover
.ruff_cache/
.mypy_cache/

# --------------------------------------------------------------
# 5. Node.js & Frontend
# --------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# --------------------------------------------------------------
# 6. ML Data & Raw Datasets (NEVER COMMIT HEAVY ASSETS)
# --------------------------------------------------------------
data/raw/
data/processed/
data/*.csv
data/*.txt
data/*.json
!data/README.md
!data/splits.example.json

# --------------------------------------------------------------
# 7. Trained Model Binaries (NEVER COMMIT HEAVY BINARIES)
# --------------------------------------------------------------
data/models/*.pt
data/models/*.pth
data/models/*.pkl
data/models/*.joblib
data/models/*.onnx
data/models/*.faiss
data/models/*.png
models/*.pt
models/*.pth
models/*.pkl
models/*.joblib
models/*.onnx
models/*.faiss
!models/demo/
!models/README.md

# --------------------------------------------------------------
# 8. Databases & Local Runtime Storage
# --------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db*

# --------------------------------------------------------------
# 9. Notebooks Checkpoints & Temporary Runs
# --------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*-checkpoint.ipynb

# --------------------------------------------------------------
# 10. Logs & Process Artifacts
# --------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.sublime-project
*.sublime-workspace

# --------------------------------------------------------------
# 11. Operating System & IDE Files
# --------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# --------------------------------------------------------------
# 12. Local Agent Scratchpads & Private Notes
# --------------------------------------------------------------
.agents/
private/
scratch/
*.tmp
