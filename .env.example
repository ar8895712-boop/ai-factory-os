# ==============================================================
# AI Factory Operating System — Root / Backend Environment Variables
# Copy this file to .env:  cp .env.example .env
# NEVER commit real API keys or passwords to version control
# ==============================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Path to master configuration YAML (defaults to ./config.yaml)
CONFIG_PATH=./config.yaml

# Database Connection URL
# Local SQLite default:
DATABASE_URL=sqlite:///./data/factory.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres_user:strong_password@localhost:5432/factory_os

# LLM / AI Assistant Integration (OpenAI API key or compatible provider)
OPENAI_API_KEY=sk-placeholder-do-not-commit-real-keys

# Allowed CORS Origins (comma-separated list without trailing slashes)
# In development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production (example):
# CORS_ORIGINS=https://ai-factory-os.vercel.app,https://yourdomain.com

# Production Security Toggles
# Set to true in production to hide /docs and /openapi.json Swagger specs
DISABLE_DOCS=false

# Rate limiting for Assistant queries (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60

# Demo Mode Flag (if true, falls back gracefully to synthetic replay if DB/models are offline)
DEMO_MODE=true

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
